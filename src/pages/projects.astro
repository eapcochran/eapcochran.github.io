---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---

<Layout title="Projects | ewen.dev" description="Selected projects showcasing architecture, delivery, and engineering impact.">
  <section class="section section--first">
    <div class="container">
      <div class="projects-heading">
        <p class="eyebrow">Selected Work</p>
        <h1>Projects</h1>
        <p class="lead">
          A selection of projects I’ve worked on, showcasing my technical skills and engineering
          approach. Each example emphasizes both implementation detail and the outcome it created.
        </p>
      </div>

      <div class="projects-grid" style="margin-top: 1.9rem;">
        {projects.map((project) => (
          <article class="card project-card">
            <p class="eyebrow-pill" style="margin-bottom: 1rem;">Featured Project</p>
            <h3>{project.title}</h3>
            <p style="margin-top: 0.7rem;">{project.description}</p>
            <div class="pill-card" style="margin-top: 1rem;">
              <p>{project.outcome}</p>
            </div>
            <div class="tag-row">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="project-card__links">
              {project.links.map((link) => (
                <a
                  class={`link-chip ${link.label === 'Demo' ? 'link-chip--accent' : ''}`}
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer' : undefined}
                >
                  {link.label === 'Code' ? '⌘' : '↗'} {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
