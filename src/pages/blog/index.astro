---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/site';
---

<Layout title="Blog | ewen.dev" description="Writing on software engineering, architecture, leadership, and delivery.">
  <section class="section section--first">
    <div class="narrow-container">
      <div class="blog-page-heading">
        <p class="eyebrow">Writing</p>
        <h2>Blog</h2>
        <p class="lead">
          Practical writing on software engineering, architecture, leadership, and the tradeoffs
          behind good delivery.
        </p>
      </div>

      <div class="blog-grid" style="margin-top: 1.9rem;">
        {blogPosts.map((post) => (
          <article class="card blog-listing">
            <div class="section-heading__row">
              <span class="tag">{post.category}</span>
              <div class="blog-listing__meta">
                <span>{post.date}</span>
                <span>{post.readingTime}</span>
              </div>
            </div>
            <div>
              <h3>{post.title}</h3>
              <p style="margin-top: 0.55rem;">{post.summary}</p>
            </div>
            <p><a class="text-link" href={`/blog/${post.slug}`}>Read More →</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
