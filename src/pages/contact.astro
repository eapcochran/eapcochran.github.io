---
import ContactForm from '../components/ContactForm';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | ewen.dev" description="Get in touch about opportunities, collaboration, or engineering conversations.">
  <section class="section section--first">
    <div class="container contact-heading">
      <h2>Get in Touch</h2>
      <p class="lead">
        I'm always interested in hearing about new opportunities, collaborations, or just having a
        chat about technology.
      </p>
    </div>

    <div class="container contact-grid" style="margin-top: 1.9rem;">
      <div class="contact-stack">
        <section class="card panel">
          <h3>Contact Information</h3>
          <div class="contact-list">
            <div class="contact-list__item">
              <div class="icon-chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18A1.5 1.5 0 0 1 22.5 7v10A1.5 1.5 0 0 1 21 18.5H3A1.5 1.5 0 0 1 1.5 17V7A1.5 1.5 0 0 1 3 5.5Zm0 1.5V7l9 6 9-6v.01L12 11.96 3 7.01ZM3 17h18V8.73l-8.58 5.72a.75.75 0 0 1-.84 0L3 8.73V17Z"></path></svg>
              </div>
              <div>
                <p class="subtle">Email</p>
                <p>your.email@example.com</p>
              </div>
            </div>
            <div class="contact-list__item">
              <div class="icon-chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5A7.5 7.5 0 0 1 19.5 10c0 5.25-6.27 10.78-6.54 11a1.5 1.5 0 0 1-1.92 0C10.77 20.78 4.5 15.25 4.5 10A7.5 7.5 0 0 1 12 2.5Zm0 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"></path></svg>
              </div>
              <div>
                <p class="subtle">Location</p>
                <p>San Francisco Bay Area</p>
              </div>
            </div>
          </div>
        </section>

        <section class="card panel">
          <h3>Connect With Me</h3>
          <div class="contact-list">
            <div class="contact-list__item">
              <div class="icon-chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38 1.56 1.56 0 0 1 6.94 8.5ZM8.5 19H5.38V9.75H8.5V19ZM19 19h-3.11v-4.5c0-1.07-.02-2.44-1.49-2.44-1.5 0-1.73 1.16-1.73 2.37V19H9.56V9.75h2.99v1.26h.04c.42-.79 1.44-1.62 2.96-1.62 3.16 0 3.75 2.08 3.75 4.79V19Z"></path></svg>
              </div>
              <div><p>LinkedIn</p></div>
            </div>
            <div class="contact-list__item">
              <div class="icon-chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.5 2.87 8.32 6.84 9.67.5.09.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.12-1.49-1.12-1.49-.91-.64.07-.63.07-.63 1.01.07 1.54 1.07 1.54 1.07.89 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.1 0-1.13.39-2.05 1.04-2.77-.11-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.37 1.91-1.34 2.75-1.06 2.75-1.06.55 1.42.2 2.46.1 2.72.65.72 1.04 1.64 1.04 2.77 0 3.97-2.33 4.83-4.56 5.09.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z"></path></svg>
              </div>
              <div><p>GitHub</p></div>
            </div>
          </div>
        </section>
      </div>

      <section class="card contact-form-card">
        <h3>Send a Message</h3>
        <ContactForm client:load />
      </section>
    </div>
  </section>
</Layout>
