---
const socialLinks = [
  { href: 'https://github.com/eapcochran', label: 'GitHub', icon: 'github' },
  { href: 'https://linkedin.com/in/ewen-cochran', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'mailto:eapcochran@gmail.com', label: 'Email', icon: 'mail' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="social-row" aria-label="Social links">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          aria-label={link.href.startsWith('mailto:') ? link.label : `${link.label} (opens in a new tab)`}
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noreferrer'}
        >
          {link.icon === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.5 2.87 8.32 6.84 9.67.5.09.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.12-1.49-1.12-1.49-.91-.64.07-.63.07-.63 1.01.07 1.54 1.07 1.54 1.07.89 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.1 0-1.13.39-2.05 1.04-2.77-.11-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.37 1.91-1.34 2.75-1.06 2.75-1.06.55 1.42.2 2.46.1 2.72.65.72 1.04 1.64 1.04 2.77 0 3.97-2.33 4.83-4.56 5.09.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z"></path>
            </svg>
          )}
          {link.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38 1.56 1.56 0 0 1 6.94 8.5ZM8.5 19H5.38V9.75H8.5V19ZM19 19h-3.11v-4.5c0-1.07-.02-2.44-1.49-2.44-1.5 0-1.73 1.16-1.73 2.37V19H9.56V9.75h2.99v1.26h.04c.42-.79 1.44-1.62 2.96-1.62 3.16 0 3.75 2.08 3.75 4.79V19Z"></path>
            </svg>
          )}
          {link.icon === 'twitter' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.88-7.39L5.6 22H2.5l7.24-8.27L1.8 2H8.2l4.41 6.76L18.9 2Zm-1.1 18h1.73L7.25 3.9H5.39L17.8 20Z"></path>
            </svg>
          )}
          {link.icon === 'mail' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 5.5h18A1.5 1.5 0 0 1 22.5 7v10A1.5 1.5 0 0 1 21 18.5H3A1.5 1.5 0 0 1 1.5 17V7A1.5 1.5 0 0 1 3 5.5Zm0 1.5V7l9 6 9-6v.01L12 11.96 3 7.01ZM3 17h18V8.73l-8.58 5.72a.75.75 0 0 1-.84 0L3 8.73V17Z"></path>
            </svg>
          )}
        </a>
      ))}
    </div>
    <p>© 2026 ewen.dev. All rights reserved.</p>
  </div>
</footer>
